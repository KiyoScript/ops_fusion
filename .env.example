# Copy to .env and fill in. See README for setup.

# ── Database ──────────────────────────────────────────────
# Option A — local Docker Postgres (docker compose up -d):
DATABASE_URL="postgresql://ops_admin:ops_dev_password@localhost:5432/ops_fusion"
# Option B — hosted (Neon / Supabase):
# DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"

# ── Auth.js ───────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Google OAuth (create at https://console.cloud.google.com/apis/credentials
# with redirect URI http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Email (optional — enables "Send email" on quotes + notifications) ─────
# Put real values in .env (gitignored), NOT here. Leave unset to disable sending.
# Gmail: turn ON 2-Step Verification, then create an App Password (Google Account
# › Security › App passwords) — NOT your normal password. In the URL, write the @
# in the email as %40 and remove the spaces from the app password. Port 465 = SSL.
# SMTP_URL="smtps://youraddress%40gmail.com:your16charapppassword@smtp.gmail.com:465"
# MAIL_FROM="Ormoc Printshoppe <youraddress@gmail.com>"
# Generic SMTP:
# SMTP_URL="smtp://user:password@smtp.example.com:587"
# NOTIFY_EMAIL="staff-inbox@example.com"
