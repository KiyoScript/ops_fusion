// ============================================================
// SALES / AUDIT — SALE (the receipt ledger)
// ============================================================

// The booklet-issued documents that RECORD REVENUE. A Collection Receipt is
// deliberately NOT here: it collects cash against a sale that already booked
// the revenue, so keeping it in its own table (collection-receipt.prisma) is
// what stops the VAT / Non-VAT reports double-counting every peso.
enum SaleType {
  SI_VAT
  SI_NON_VAT
  // Sale on credit (docs/sales.txt §3.1.3). Books revenue AT POINT OF SALE
  // like any other invoice — what differs is that the money has not arrived:
  // the unpaid part sits in Accounts Receivable until a Collection Receipt
  // settles it. Carries VAT exactly as SI_VAT does.
  SI_CHARGE
  JO_SLIP // Job Order receipt — the downpayment / acknowledgement slip
}

// How much of the document's amount has actually been received.
//   PAID    — settled in full at issue (the ordinary cash sale)
//   PARTIAL — some money came in; the rest is Accounts Receivable
//   UNPAID  — nothing came in; the whole amount is A/R (a Charge Invoice)
// Derived from amountPaid vs amount, never set by hand.
enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

// Shared by Sale and CollectionReceipt (collection-receipt.prisma).
//
// docs/sales.txt §5: a spoiled receipt is never thrown away or renumbered —
// it stays in the booklet at its own serial position so all 50 leaves can be
// accounted for.
//
// The shop writes ONE word on the face of the leaf — CANCELLED — whatever the
// reason and whether or not a new receipt takes its place. There is no
// separate physical "void" gesture and no separate "replace" gesture: you
// cancel the leaf, and if the transaction still stands you write a new one.
// So there is ONE action in the app, Cancel, and this enum is a system record
// rather than a choice put to the cashier:
//   CANCELLED — every cancellation. The only value anything writes.
//   VOID      — legacy rows only; nothing writes it any more.
//   REPLACED  — legacy rows only, from when reissuing was its own action.
//               Paired with replacedById on those rows, which is what the day
//               log still reads to show the two serials against each other.
// The UI shows CANCELLED for all three, because that is what the paper says.
enum ReceiptVoidType {
  CANCELLED
  VOID
  REPLACED
}

// A receipt issued at the counter: Job Order receipt, or Sales Invoice
// (VAT / Non-VAT). Raised from a Job Order via Receive Payment, or standalone
// for non-JO transactions (photocopy, laminate, supplies).
model Sale {
  id         String    @id @default(cuid())
  documentNo String    @unique // "IN-0578" — unique across the whole ledger
  bookletId  String?
  booklet    Booklet?  @relation(fields: [bookletId], references: [id])
  type       SaleType
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  // NOT unique: one JO takes a JO_SLIP downpayment first and an SI later.
  jobOrderId String? // null → non-JO transaction
  jobOrder   JobOrder? @relation(fields: [jobOrderId], references: [id])
  saleDate   DateTime

  // — money (VAT backed OUT of a VAT-inclusive amount, as the legacy
  //   SalesLogService does: vatable = amount / 1.12, vat = vatable * 0.12) —
  amount       Decimal @db.Decimal(12, 2) // gross, VAT-inclusive
  vatableSales Decimal @default(0) @db.Decimal(12, 2) // net of VAT
  vatAmount    Decimal @default(0) @db.Decimal(12, 2) // 0 for NON_VAT / JO_SLIP

  // JO_SLIP only. A Job Order receipt is TWO different documents wearing one
  // name, and which one it is decides whether it books revenue:
  //
  //   false — the customer paid and walked out. No invoice will follow, so
  //           this slip IS the sale document and its money IS revenue.
  //   true  — a downpayment on work not finished. Money held against a job
  //           that has not been billed: a customer deposit (account 2121),
  //           no revenue, and more slips may follow on the same job.
  //
  // Nothing can infer this after the fact — a ₱5,000 slip on a ₱20,000 job
  // looks identical whether the customer is coming back or not. So the
  // cashier tags it at the counter, which is also the only moment anyone
  // knows. Defaults to false: the legacy JO receipt was the walk-in sale.
  isDownpayment Boolean @default(false)

  // — the counter —
  amountPaid    Decimal        @default(0) @db.Decimal(12, 2) // applied to this document
  cashTendered  Decimal?       @db.Decimal(12, 2) // what the customer handed over
  changeGiven   Decimal        @default(0) @db.Decimal(12, 2) // tendered − paid
  paymentMethod PaymentMethod?
  methodDetail  String? // cheque no. / GCash reference
  paymentStatus PaymentStatus  @default(PAID)

  // Collected AFTER issue, via CrAllocation (collection-receipt.prisma).
  //
  // Deliberately separate from amountPaid: amountPaid is what the printed
  // invoice says was handed over at the counter, and a receipt is a legal
  // record — settling a Charge Invoice next month must not rewrite it. The
  // open balance is therefore `amount − amountPaid − settledAmount`.
  //
  // Denormalised from sum(CrAllocation.amount) and maintained in the SAME
  // transaction as the allocation, so a customer-wide A/R list is one indexed
  // scan instead of a join-and-aggregate per invoice.
  settledAmount Decimal @default(0) @db.Decimal(12, 2)

  // SI_CHARGE only: saleDate + the customer's credit terms, frozen at issue.
  // Stored rather than derived because Customer.creditTermDays may change, and
  // an invoice's due date must not move under an aging report that already
  // counted it. Null on every other type — they are paid at the counter.
  dueDate DateTime?

  // Snapshot of who it was billed to, taken AT ISSUE. A receipt is a legal
  // record: editing the Customer's TIN next year must not silently rewrite
  // last year's invoice.
  billedToName    String?
  billedToAddress String?
  billedToTin     String?

  // — cancelled / voided / replaced (docs/sales.txt §5) —
  // NOT a soft delete: the row stays, keeps its serial number, and simply
  // stops counting as revenue. deletedAt hides a receipt; voidedAt accounts
  // for it. The booklet number is never reissued either way.
  voidType   ReceiptVoidType?
  voidReason String?
  voidedAt   DateTime?
  voidedById String?
  // The supervisor who approved the cancellation — §5.1 step 6 wants the
  // issuer (createdBy) and an approver both named on it.
  voidedBy   User?            @relation("SaleVoidedBy", fields: [voidedById], references: [id])

  // REPLACED only: written on the spoiled receipt, pointing at the one issued
  // in its place (§5.1 step 3). `replaces` is the same link read backwards —
  // newReceipt.replaces is the receipt it superseded.
  replacedById String? @unique
  replacedBy   Sale?   @relation("SaleReplacement", fields: [replacedById], references: [id])
  replaces     Sale?   @relation("SaleReplacement")

  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String
  createdBy   User      @relation("SaleCreatedBy", fields: [createdById], references: [id])

  auditEntries  AuditEntry[]
  crAllocations CrAllocation[]
  // Split tender: one row per method. See receipt-payment.prisma.
  payments      ReceiptPayment[]

  @@index([customerId])
  @@index([saleDate])
  @@index([type])
  @@index([deletedAt])
  @@index([bookletId])
  @@index([createdById])
  @@index([jobOrderId])
  // The cancellation log (§5.1 step 5) is a scan of this index.
  @@index([voidedAt])
  // The A/R ledger: open charge invoices for one customer, oldest first.
  @@index([customerId, type, dueDate])
}
