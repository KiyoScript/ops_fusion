// ============================================================
// SALES / AUDIT — BOOKLET
// ============================================================

// The three SI_* values are the Sales Invoice's "three separate labels of use"
// (docs/sales.txt §3.1). They sit on TWO number lines, not three and not one:
//
//   IN — SI_VAT + SI_CHARGE, printed as one continuous series. A booklet is
//        pre-printed for a single label, but its numbers carry on from
//        whichever of the two came before it, so neither restarts at 1 and no
//        two of them may claim the same numbers. Only the wording differs.
//   NV — SI_NON_VAT, printed as its own series with its own numbering. It
//        neither continues nor consumes any part of the IN line.
//
// The "prefix" column is what identifies the line — see BOOKLET_PREFIX in
// schemas/booklet.ts and the Booklet_no_overlapping_ranges constraint, which
// keys on it, so IN-0578 and NV-0578 can coexist while two IN-0578s cannot.
enum BookletType {
  SI_VAT
  // Its own NV series — not part of the IN line.
  SI_NON_VAT
  // Sales Invoice used for a sale on credit (utang) — docs/sales.txt §3.1.3.
  SI_CHARGE
  JO_SLIP
  CR
  DR
}

// The legacy Doc_Series lifecycle (DocSeriesService.js):
//   Unopened → Requested → Active → Fully Consumed
//                       ↘ Rejected → (re-request) → Requested
// PENDING_APPROVAL is the legacy "Requested"; CONSUMED is "Fully Consumed".
enum BookletStatus {
  UNOPENED
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  CONSUMED
  CLOSED
}

// One numbering pattern shared by SI / JO Slip / CR / DR booklets, with
// approval-on-opening (spec 3.1, 4). The range is sized per booklet — the
// service suggests the next block after the last range on that number line,
// but the admin sets it freely (a 25-, 50- or 100-leaf booklet all work).
//
// INVARIANT: at most one ACTIVE booklet per type, enforced by a partial unique
// index in the migration (Prisma can't express one). "The next number" has to
// be unambiguous when a cashier hits Receive Payment.
model Booklet {
  id            String        @id @default(cuid())
  type          BookletType
  // IN / NV / JO / CR / DR — builds the number: IN-0578. Stored per booklet
  // rather than derived from `type` on read, because it is what was physically
  // printed on the leaves: re-pointing a type at a new line (as SI_NON_VAT
  // moved from IN to NV) must not renumber booklets already in the drawer.
  prefix        String
  label         String?
  seriesStart   Int
  seriesEnd     Int
  nextNumber    Int
  status        BookletStatus @default(PENDING_APPROVAL)
  // Legacy gap_exempt: suppress the missing-number flag for this booklet
  // (e.g. leaves voided before the system existed).
  gapExempt     Boolean       @default(false)
  rejectionNote String?
  openedById    String
  openedBy      User          @relation("BookletOpenedBy", fields: [openedById], references: [id])
  approvedById  String?
  approvedBy    User?         @relation("BookletApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  sales              Sale[]
  collectionReceipts CollectionReceipt[]
  deliveryReceipts   DeliveryReceipt[]

  @@index([type, status])
  @@index([openedById])
  @@index([approvedById])
}
