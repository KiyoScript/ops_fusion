// ============================================================
// SHARED MASTERS — CUSTOMER
// ============================================================

// Placeholder classification — real client rules pending (spec 2.2 table missing).
enum CustomerType {
  TYPE_A
  TYPE_B
  TYPE_C
}

// Whether the customer is still active business. Distinct from soft-delete
// (deletedAt): inactive customers are retained + filterable, not removed.
enum CustomerStatus {
  ACTIVE
  INACTIVE
}

// Tax standing — replaces the vatRegistered boolean. NO_TIN = walk-in / no BIR
// registration; used when the customer/company has no TIN at all.
enum VatStatus {
  VAT
  NON_VAT
  NO_TIN
}

model Customer {
  id              String         @id @default(cuid())
  // `name` is the canonical DISPLAY form, kept in sync = "Lastname, Firstname MI."
  // (composePersonName). The structured parts below are the source of truth for
  // NEW/edited person customers and drive dedup; legacy rows keep their original
  // free-text `name` until edited (firstName/lastName may be null).
  name            String
  lastName        String?
  firstName       String?
  middleInitial   String?
  contactNumber   String?
  company         String? // denormalized company name (kept in sync for existing readers)
  companyId       String?
  companyRef      Company? @relation("CompanyContacts", fields: [companyId], references: [id])
  department      String? // contact-person's department (company contacts)
  position        String? // contact-person's position (company contacts)
  email           String?
  // `address` is the BILLING address (what receipts are made out to — used by
  // Sales & Audit). shippingAddress is where goods are delivered (DR).
  address         String?
  shippingAddress String?
  tin             String?
  customerType    CustomerType   @default(TYPE_C)
  status          CustomerStatus @default(ACTIVE)
  vatRegistered   Boolean        @default(false) // deprecated → vatStatus
  vatStatus       VatStatus?

  // — credit control —
  //
  // NOT a legacy rule: docs/sales.txt describes Charge Invoices and Collection
  // Receipts but sets no terms or ceiling. Added deliberately with the A/R
  // module and gated behind the `credit-control` flag (src/lib/modules.ts), so
  // the shop can run exactly as before with it switched off.
  //
  // Null on both = no terms agreed and no ceiling: charge invoices are allowed
  // and simply never fall due. That is the pre-existing behaviour, so existing
  // customers keep working untouched after the migration.
  /// Net days until a Charge Invoice falls due — 15 / 30 / 60. Null = no terms.
  creditTermDays Int?
  /// Ceiling on this customer's total open A/R. Null = no ceiling.
  creditLimit    Decimal? @db.Decimal(12, 2)

  // — tax withheld at source (withholding.prisma) —
  //
  // TWO independent withholdings, because a customer may do either, both, or
  // neither. Both rates apply to the VAT-EXCLUSIVE amount.
  //
  //   isWithholdingAgent — withholds creditable INCOME tax (1% goods / 2%
  //     services), issues BIR Form 2307. Only BIR-designated Top Withholding
  //     Agents do this, not every company.
  //   withholdsVat — withholds 5% creditable VALUE-ADDED tax, issues BIR Form
  //     2306. Government agencies, LGUs, public schools and GOCCs. Creditable
  //     rather than final since 1 Jan 2021 (RMC 36-2021).
  //
  // A government customer has BOTH set: on a ₱112,000 job they keep ₱2,000 and
  // ₱5,000 and pay ₱105,000. Off on both for everyone else, and the counter
  // never shows a withholding field for them.
  //
  // Reference data an admin sets, like the credit fields above — see R8 in
  // docs/sales-contract.md. The cashier taking the money does not get to
  // decide what rate a customer withholds at.
  /// True → the collect screen offers an income-tax withholding line.
  isWithholdingAgent    Boolean  @default(false)
  /// e.g. 2.00 for 2%. Null = flagged, but nothing pre-filled — the cashier
  /// types what the 2307 in their hand actually says.
  ewtRatePct            Decimal? @db.Decimal(5, 2)
  /// True → the collect screen offers a VAT withholding line. Government.
  withholdsVat          Boolean  @default(false)
  /// Statutory 5.00 today, stored rather than hardcoded so a rate change is a
  /// maintenance edit and never rewrites what past collections withheld.
  vatWithholdingRatePct Decimal? @db.Decimal(5, 2)

  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String
  createdBy   User      @relation("CustomerCreatedBy", fields: [createdById], references: [id])

  inquiries          Inquiry[]
  quotations         Quotation[]
  jobOrders          JobOrder[]
  sales              Sale[]
  collectionReceipts CollectionReceipt[]
  advancePayments    AdvancePayment[]
  deliveryReceipts   DeliveryReceipt[]
  attachments        CustomerAttachment[]
  whtCertificates    WithholdingCertificate[]

  @@index([name])
  @@index([customerType])
  @@index([status])
  @@index([deletedAt])
  @@index([createdById])
  @@index([companyId])
}
