// ============================================================
// MATERIAL REQUESTS — issue stock to job orders (MACWebApp fusion, Slice 2)
//
// The stock-OUT path: production requests materials against a JO → a
// supervisor APPROVES (never auto-approved, even for admins) → a storekeeper
// RELEASES → each released line posts a RELEASE row to the stock ledger
// (qtyOut). On-hand stays DERIVED from the ledger — nothing is decremented in
// place. Release can be partial (per line, and per quantity); a reject/cancel
// is blocked once anything has been released.
// ============================================================

enum MrStatus {
  PENDING // submitted, awaiting approval
  APPROVED // approved, nothing released yet
  PARTIALLY_RELEASED // some quantity released
  RELEASED // fully released
  REJECTED
  CANCELLED
}

model MaterialRequest {
  id             String    @id @default(cuid())
  number         String    @unique // MR-ORM-YYMM-#####
  status         MrStatus  @default(PENDING)
  // "For JO" — optional so shop-use requests (not tied to a JO) are possible.
  jobOrderId     String?
  jobOrder       JobOrder? @relation(fields: [jobOrderId], references: [id])
  purpose        String? // free-text reason when there's no JO
  requestedById  String
  requestedBy    User      @relation("MrRequestedBy", fields: [requestedById], references: [id])
  requestedAt    DateTime  @default(now())
  // Approval decision (approve or reject) — always an explicit step.
  decidedById    String?
  decidedBy      User?     @relation("MrDecidedBy", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  decisionNote   String? // reject reason / approval remark
  // Release (stock issued) — may happen across several partial releases.
  releasedById   String?
  releasedBy     User?     @relation("MrReleasedBy", fields: [releasedById], references: [id])
  lastReleasedAt DateTime?
  releaseNote    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  lines MaterialRequestLine[]

  @@index([status])
  @@index([number])
  @@index([jobOrderId])
  @@index([requestedById])
  @@index([deletedAt])
}

model MaterialRequestLine {
  id                 String          @id @default(cuid())
  requestId          String
  request            MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  materialId         String
  material           Material        @relation(fields: [materialId], references: [id])
  qtyNeeded          Int // pcs requested
  qtyReleased        Int             @default(0) // pcs released so far
  systemQtyAtRequest Int // derived on-hand snapshot at request time (pcs)
  unitCostAtRequest  Decimal         @db.Decimal(12, 4) // cost/pc snapshot for costing
  releaseNote        String?

  @@index([requestId])
  @@index([materialId])
}
